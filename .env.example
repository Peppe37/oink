# Where people reach Oink (bank authorisations come back here).
OINK_PUBLIC_URL=http://localhost:8080
# First run only: the owner's password (at least 10 characters). Or choose it in the browser.
OINK_ADMIN_PASSWORD=
OINK_CURRENCY=EUR
OINK_TIMEZONE=Europe/Rome
OINK_LANGUAGE=it
# Behind a reverse proxy: its address, so client IPs and https are read correctly.
OINK_TRUSTED_PROXIES=127.0.0.1

# --- AI (optional): any LiteLLM model id + that provider's usual key -------------------
# OINK_AI_MODEL=openai/gpt-5.4-mini            OPENAI_API_KEY=...
# OINK_AI_MODEL=anthropic/claude-sonnet-5-5    ANTHROPIC_API_KEY=...
# OINK_AI_MODEL=deepseek/deepseek-chat         DEEPSEEK_API_KEY=...
# OINK_AI_MODEL=ollama/llama3.1                OINK_AI_BASE_URL=http://ollama:11434
OINK_AI_MODEL=
# false = only totals per category leave the server (no descriptions, no merchants).
OINK_AI_SEND_DESCRIPTIONS=true

# --- Bank sync (optional): Enable Banking, free for your own accounts --------------------
OINK_ENABLE_BANKING_APP_ID=
OINK_ENABLE_BANKING_KEY_FILE=/data/enablebanking.pem
OINK_ENABLE_BANKING_COUNTRY=IT
OINK_SYNC_HOURS=6
# Day of the month accounts without a bank link ask for last month's statement.
OINK_STATEMENT_DAY=1
