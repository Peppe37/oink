# Where people reach Oink (bank authorisations and invite links use it).
OINK_PUBLIC_URL=http://localhost:8080
# First run only: creates the admin. Or leave empty and create it in the browser.
OINK_ADMIN_USERNAME=admin
OINK_ADMIN_PASSWORD=
# Default main currency of new users (each user can change theirs).
OINK_CURRENCY=EUR
OINK_TIMEZONE=Europe/Rome
# Encrypts the API keys of linked accounts. Empty = a key generated in ./data/secret.key.
OINK_SECRET_KEY=
# Behind a reverse proxy: its address, so client IPs and https are read correctly.
OINK_TRUSTED_PROXIES=127.0.0.1
# Pin a version instead of following the latest release (used by docker-compose.yml).
# OINK_TAG=0.2.0

# --- AI (optional): any LiteLLM model id + that provider's usual key -------------------
# OINK_AI_MODEL=openai/gpt-5.4-mini            OPENAI_API_KEY=...
# OINK_AI_MODEL=anthropic/claude-sonnet-5-5    ANTHROPIC_API_KEY=...
# OINK_AI_MODEL=deepseek/deepseek-chat         DEEPSEEK_API_KEY=...
# OINK_AI_MODEL=ollama/llama3.1                OINK_AI_BASE_URL=http://ollama:11434
OINK_AI_MODEL=
# false = only totals per category leave the server (no descriptions, no merchants).
OINK_AI_SEND_DESCRIPTIONS=true

# --- Bank sync (optional): Enable Banking, free for your own accounts --------------------
# Easier: set it up in the app (Settings → Bank access). Or here:
OINK_ENABLE_BANKING_APP_ID=
OINK_ENABLE_BANKING_KEY_FILE=/data/enablebanking.pem
OINK_SYNC_HOURS=6
# Day of the month accounts without a link ask for last month's statement.
OINK_STATEMENT_DAY=1

# --- Updates ---------------------------------------------------------------------------
OINK_UPDATE_CHECK=true

# --- Single sign-on (optional): any OpenID Connect provider (Keycloak, Authentik…) -------
# Redirect URI to register at the provider: <OINK_PUBLIC_URL>/api/auth/oidc/callback
# OINK_OIDC_ISSUER=https://sso.example.com/realms/home
# OINK_OIDC_CLIENT_ID=oink
# OINK_OIDC_CLIENT_SECRET=
# OINK_OIDC_NAME=Keycloak
# OINK_OIDC_ADMIN_GROUP=oink-admins
# OINK_OIDC_AUTO_CREATE=true
# OINK_PASSWORD_LOGIN=true
